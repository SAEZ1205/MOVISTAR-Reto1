PORT=4000
CALL_PROVIDER=simulation
# summary_only: llama al asesor, lee el resumen y termina. bridge: luego llama al cliente y los conecta.
CALL_FLOW=summary_only

# Telefonía real: cambia CALL_PROVIDER a telnyx después de validar la demo.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_FROM_NUMBER=
TELNYX_TTS_VOICE=Telnyx.KokoroTTS.af_heart

# Tu celular de prueba en formato E.164, por ejemplo +519XXXXXXXX.
ADVISOR_PHONE=+51900000000
# Solo se requiere cuando CALL_FLOW=bridge.
DEMO_CLIENT_PHONE=+51900000000

# URL HTTPS pública del backend (Render/Railway/ngrok).
PUBLIC_BASE_URL=

# Separa varios orígenes con coma.
FRONTEND_ORIGIN=http://127.0.0.1:3000,http://localhost:3000,https://movistar-reto1-nliq.vercel.app
